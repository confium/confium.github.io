{
  "name": "confium.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confium — open-source threshold-native trust infrastructure. Source of https://www.confium.org (Astro 7 + Vite 8 + Tailwind 4 + Vue).",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "predev": "node scripts/fetch-sources.mjs && node scripts/prepare-dev-search.mjs",
    "prebuild": "node scripts/fetch-sources.mjs",
    "postbuild": "pagefind --site dist",
    "fetch-sources": "node scripts/fetch-sources.mjs",
    "check:gates": "node scripts/check-gates.mjs dist",
    "check:links": "lychee --root-dir \"$PWD/dist\" --config lychee.toml --no-progress 'dist/**/*.html'",
    "check:links:external": "lychee --root-dir \"$PWD/dist\" --config lychee.toml --no-progress 'dist/**/*.html'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vue": "7.0.1",
    "@confium/confium-wasm": "^0.4.7",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.1.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.40",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "pagefind": "1.5.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
