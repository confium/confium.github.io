---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Build',
    links: [
      { label: 'Docs', href: '/docs/' },
      { label: 'Software', href: '/software/' },
      { label: 'Plugins', href: '/plugins/' },
      { label: 'Contribute', href: '/contribute/' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Concepts', href: '/concepts/' },
      { label: 'Specs', href: '/specs/' },
      { label: 'Glossary', href: '/glossary/' },
      { label: 'Blog', href: '/blog/' },
    ],
  },
  {
    title: 'Use',
    links: [
      { label: 'Use cases', href: '/use-cases/' },
      { label: 'For You', href: '/audiences/' },
      { label: 'Security', href: '/security/' },
      { label: 'Funding', href: '/funding/' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'RSS feed', href: '/rss.xml' },
    ],
  },
];
---

<footer class="bg-[#0c1024] text-[#a8aec9]">
  <hr class="gradient-rule" />
  <div class="mx-auto w-full max-w-6xl px-6 py-14">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2 font-sans text-lg font-bold tracking-tight lowercase text-white">
          <span class="w-10 h-6 inline-block">
            <svg viewBox="0 0 275.37 167.48" class="w-full h-full" aria-hidden="true">
              <path fill="#1a7bec" d="M95.79,83.73a95.44,95.44,0,0,1,31.82-71.27,83.73,83.73,0,1,0,0,142.54A95.44,95.44,0,0,1,95.79,83.73Z" transform="translate(0.08 0.01)" />
              <path fill="#00dfb7" d="M179.46,83.73A95.44,95.44,0,0,1,147.6,155a83.73,83.73,0,1,0,0-142.54A95.44,95.44,0,0,1,179.46,83.73Z" transform="translate(0.08 0.01)" />
              <path fill="#ffdc4a" d="M167.49,83.73a83.57,83.57,0,0,0-29.87-64,83.59,83.59,0,0,0,0,128.09A83.57,83.57,0,0,0,167.49,83.73Z" transform="translate(0.08 0.01)" />
            </svg>
          </span>
          <span>confium</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed max-w-sm">
          Threshold-native trust infrastructure for a post-quantum world.
          Open-source, BSD-2-Clause, funded by NLnet NGI Zero PET and Mozilla MOSS.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a
            href="https://github.com/confium"
            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/40 hover:text-white transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
            </svg>
          </a>
          <a
            href="/rss.xml"
            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/40 hover:text-white transition-colors"
            aria-label="RSS"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A19.56 19.56 0 0 1 19.56 20h-2.83A16.73 16.73 0 0 0 4 7.27V4.44zm0 5.66a14.9 14.9 0 0 1 9.9 9.9h-2.83A12.07 12.07 0 0 0 4 12.93V10.1z" />
            </svg>
          </a>
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.18em] text-[#5f6788] mb-4">
            {col.title}
          </h3>
          <ul class="space-y-2 text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row items-baseline justify-between gap-3 text-xs">
      <p class="font-mono text-[#5f6788]">
        © {year} Confium contributors · BSD-2-Clause
      </p>
      <p class="font-mono text-[#5f6788]">
        Developed in the open · Sponsored by NLnet NGI Zero PET + Mozilla MOSS
      </p>
    </div>
  </div>
</footer>
