---
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Software',
    links: [
      { label: 'Rust workspace', href: '/software/rust/' },
      { label: 'Ruby gem', href: '/software/ruby/' },
      { label: 'WASM verifier', href: '/software/wasm/' },
      { label: 'All software', href: '/software/' },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Specs', href: '/specs/' },
      { label: 'Contribute', href: '/contribute/' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Security', href: '/security/' },
      { label: 'Funding', href: '/funding/' },
      { label: 'Glossary', href: '/glossary/' },
      { label: 'RSS feed', href: '/rss.xml' },
    ],
  },
];
---

<footer class="bg-[#0c1024] text-[#a8aec9]">
  <hr class="gradient-rule" />
  <div class="mx-auto w-full max-w-6xl px-6 py-14">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      <div class="col-span-2">
        <a href="/" class="flex items-center gap-2 font-sans text-lg font-semibold text-white">
          <span class="w-6 h-6 inline-block text-[#5ea2f5]">
            <svg viewBox="0 0 512 512" fill="currentColor" class="w-full h-full" aria-hidden="true">
              <path d="M239.1 6.3l-208 78c-18.7 7-31.1 25-31.1 45v225.1c0 18.2 10.3 34.8 26.5 42.9l208 104c13.5 6.8 29.4 6.8 42.9 0l208-104c16.3-8.1 26.5-24.8 26.5-42.9V129.3c0-20-12.4-37.9-31.1-44.9l-208-78C262 2.2 250 2.2 239.1 6.3zM256 34.2l224 84v.3l-224 97.1-224-97.1v-.3l224-84zM32 153.4l208 90.1v224.7l-208-104V153.4zm240 314.8V243.5l208-90.1v210.9L272 468.2z" />
            </svg>
          </span>
          <span>Confium</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed max-w-sm">
          Threshold-native trust infrastructure for a post-quantum world.
          Open-source, BSD-2-Clause, funded by NLnet NGI Zero PET and Mozilla MOSS.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a
            href="https://github.com/confium"
            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/40 hover:text-white transition-colors"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15.08-.1.36-.45.08-1.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.28.67-.1 1.02-.08 1.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
          </a>
          <a
            href="/rss.xml"
            class="inline-flex items-center justify-center w-9 h-9 rounded-full border border-white/10 hover:border-white/40 hover:text-white transition-colors"
            aria-label="RSS"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A19.56 19.56 0 0 1 19.56 20h-2.83A16.73 16.73 0 0 0 4 7.27V4.44zm0 5.66a14.9 14.9 0 0 1 9.9 9.9h-2.83A12.07 12.07 0 0 0 4 12.93V10.1z" />
            </svg>
          </a>
        </div>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="font-mono text-[0.72rem] font-bold uppercase tracking-[0.18em] text-[#5f6788] mb-4">
            {col.title}
          </h3>
          <ul class="space-y-2 text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row items-baseline justify-between gap-3 text-xs">
      <p class="font-mono text-[#5f6788]">
        © {year} Confium contributors · BSD-2-Clause
      </p>
      <p class="font-mono text-[#5f6788]">
        Developed in the open · Sponsored by NLnet NGI Zero PET + Mozilla MOSS
      </p>
    </div>
  </div>
</footer>
