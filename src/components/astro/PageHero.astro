---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-line bg-card/30">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    {eyebrow && (
      <p class="text-xs font-mono uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-3">
        {eyebrow}
      </p>
    )}
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">{title}</h1>
    {description && (
      <p class="mt-4 text-lg text-muted-foreground max-w-3xl">{description}</p>
    )}
    <div class="mt-6 h-px bg-gradient-to-r from-brand-500 to-transparent" />
  </div>
</section>
