  <!-- n -->
  <path d="M214 38 L232 38 L232 50 C238 42 250 36 264 36 C290 36 308 56 308 82 L308 122 L290 122 L290 82 C290 66 280 54 264 54 C248 54 232 66 232 82 L232 122 L214 122 Z" />
  <!-- f -->
  <path d="M326 8 L344 8 L344 38 L362 38 L362 56 L344 56 L344 122 L326 122 L326 56 L314 56 L314 38 L326 38 Z" />
  <!-- i (with cube dot in brand color) -->
  <path d="M380 38 L398 38 L398 122 L380 122 Z" />
  <!-- Brand-color cube dot above the "i" — three faces in brand palette -->
  <g transform="translate(380 6)">
    <path d="M9 0 L18 4 L9 8 L0 4 Z" fill="#1a7bec" />
    <path d="M0 4 L9 8 L9 18 L0 14 Z" fill="#00dfb7" />
    <path d="M18 4 L9 8 L9 18 L18 14 Z" fill="#ffdc4a" />
