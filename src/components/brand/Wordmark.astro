---
/**
 * Confium wordmark — custom typographic treatment. Lowercase "confium"
 * set in IBM Plex Sans with a tight tracking and the dot on the "i"
 * replaced by a brand-colored cube for distinctiveness.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 540 130"
  class={className}
  fill="currentColor"
  role="img"
  aria-label="confium"
>
  <!-- "confium" set as a custom wordmark in IBM Plex Sans Bold geometry.
       Letters drawn to match RNP's wordmark approach. -->
  <!-- c -->
  <path d="M68 32 C42 32 22 52 22 78 C22 104 42 124 68 124 C82 124 96 118 106 108 L94 96 C88 102 78 106 68 106 C52 106 40 94 40 78 C40 62 52 50 68 50 C78 50 88 54 94 60 L106 48 C96 38 82 32 68 32 Z" />
  <!-- o -->
