---
/**
 * Confium wordmark — clean lowercase "confium" in IBM Plex Sans Bold.
 * Matches RNP's wordmark approach: simple, bold, no decorative elements.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class={`font-sans font-bold tracking-tight lowercase ${className}`}>
  confium
</span>
