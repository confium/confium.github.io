  <!-- u -->
  <path d="M416 38 L434 38 L434 78 C434 94 444 106 458 106 C472 106 482 94 482 78 L482 38 L500 38 L500 122 L482 122 L482 110 C476 118 466 124 458 124 C432 124 416 104 416 78 Z" />
  <!-- m -->
  <path d="M518 38 L536 38 L536 50 C542 42 552 36 564 36 C576 36 586 42 592 50 C600 42 612 36 624 36 C650 36 666 56 666 82 L666 122 L648 122 L648 82 C648 66 638 54 624 54 C610 54 600 66 600 82 L600 122 L582 122 L582 82 C582 66 572 54 564 54 C552 54 536 66 536 82 L536 122 L518 122 Z" />
</svg>
