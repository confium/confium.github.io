---
/**
 * Confium symbol mark — three intersecting cube faces in the brand
 * palette (blue, teal, gold). Designed in the same visual language
 * as the sister RNP site's three-circle mark, adapted to Confium's
 * cube geometry. The three faces represent the three deployment
 * modes (Peer-to-Peer TC, PKI Drop-in, Sovereign PKI).
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 275 275"
  class={className}
  role="img"
  aria-label="Confium symbol"
>
  <!-- Top face (blue) — Mode 1: Peer-to-Peer TC -->
  <path
    fill="#1a7bec"
    d="M137.5 12 L263 70 L137.5 128 L12 70 Z"
    opacity="0.95"
  />
  <!-- Left face (teal) — Mode 2: PKI Drop-in -->
  <path
    fill="#00dfb7"
    d="M12 70 L137.5 128 L137.5 263 L12 205 Z"
    opacity="0.92"
  />
  <!-- Right face (gold) — Mode 3: Sovereign PKI -->
  <path
    fill="#ffdc4a"
    d="M263 70 L137.5 128 L137.5 263 L263 205 Z"
    opacity="0.92"
  />
  <!-- Edges for definition -->
  <path
    fill="none"
    stroke="#0f1326"
    stroke-width="1.5"
    stroke-linejoin="round"
    opacity="0.25"
    d="M137.5 12 L263 70 L263 205 L137.5 263 L12 205 L12 70 Z"
  />
  <path
    fill="none"
    stroke="#0f1326"
    stroke-width="1.5"
    stroke-linejoin="round"
    opacity="0.25"
    d="M137.5 128 L137.5 263 M12 70 L137.5 128 L263 70"
  />
</svg>
