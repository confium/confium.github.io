---
import BaseLayout from './BaseLayout.astro';
import TocNav from '@components/astro/TocNav.astro';
import Prose from '@components/astro/Prose.astro';

interface Props {
  title: string;
  description?: string;
  // Grouped form: [{ heading?, items }]; flat callers may still
  // pass a bare item array, normalized below.
  sidebar?: ({ heading?: string; items: { label: string; href: string; current?: boolean }[] } | { label: string; href: string; current?: boolean })[];
  sourcePath?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  sourcePath,
  headings = [],
} = Astro.props;

const rawSidebar = Astro.props.sidebar ?? [];
const sidebar = rawSidebar.map((entry) => ('items' in entry ? entry : { items: [entry] }));

const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
    <div class="lg:grid lg:grid-cols-[16rem_minmax(0,1fr)_14rem] lg:gap-8">
      {sidebar.length > 0 && (
        <aside class="hidden lg:block">
          <nav class="sticky top-24 space-y-4">
            {sidebar.map((group) => (
              <div>
                {group.heading && (
                  <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground/70">
                    {group.heading}
                  </p>
                )}
                <div class="space-y-1">
                  {group.items.map((item) => (
                    <a
                      href={item.href}
                      class={`block rounded-md px-3 py-1.5 text-sm transition-colors ${
                        item.current
                          ? 'bg-brand-50 dark:bg-brand-900/20 text-brand-700 dark:text-brand-300 font-medium'
                          : 'text-muted-foreground hover:text-foreground hover:bg-brand-50/50 dark:hover:bg-brand-900/10'
                      }`}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </nav>
        </aside>
      )}

      <div>
        <Prose>
          <slot />
        </Prose>
        {sourcePath && (
          <footer class="mt-10 pt-6 border-t border-line text-xs text-muted flex flex-wrap items-center gap-x-3 gap-y-1">
            <a
              href={`https://github.com/confium/confium.github.io/edit/main/${sourcePath}`}
              class="text-accent hover:text-accent-deep font-medium inline-flex items-center gap-1"
              rel="noopener noreferrer"
              target="_blank"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm.176 4.823L9.75 4.81l-6.286 6.287a.253.253 0 0 0-.064.108l-.558 1.953 1.953-.558a.253.253 0 0 0 .108-.064Zm1.238-3.763a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354Z" />
              </svg>
              Edit on GitHub
            </a>
            <span aria-hidden="true" class="text-faint">·</span>
            <span class="font-mono text-faint">{sourcePath}</span>
          </footer>
        )}
      </div>

      {filteredHeadings.length >= 4 && (
        <aside class="hidden xl:block">
          <TocNav headings={filteredHeadings} />
        </aside>
      )}
    </div>
  </div>
</BaseLayout>
