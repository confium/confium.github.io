---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';

const concepts = (await getCollection('concepts')).sort((a, b) => {
  const aOrder = a.data.order ?? 99;
  const bOrder = b.data.order ?? 99;
  return aOrder - bOrder;
});

const sidebar = concepts.map((c) => ({
  label: c.data.title,
  href: `/concepts/${c.id}/`,
}));
const indexSidebar = sidebar.map((s) => ({ ...s, current: false }));
---

<DocsLayout title="Concepts" description="Educational hub for Confium. Threshold crypto, the TLS analogy, composite signatures, transparency logs, attribute-based threshold." sidebar={indexSidebar}>
  <PageHero
    eyebrow="Concepts"
    title="Threshold cryptography, explained"
    description="Educational on-ramp for Confium. If you're new to threshold crypto, start here."
  />

  <ul class="mt-8 space-y-4">
    {concepts.map((c) => (
      <li>
        <a href={`/concepts/${c.id}/`} class="group block rounded-lg border border-line bg-card p-5 hover:border-brand-300 dark:hover:border-brand-700 transition-colors">
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="text-lg font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-300">{c.data.title}</h2>
            <span aria-hidden="true" class="text-muted-foreground group-hover:text-brand-600">→</span>
          </div>
          {c.data.description && (
            <p class="mt-1 text-sm text-muted-foreground">{c.data.description}</p>
          )}
        </a>
      </li>
    ))}
  </ul>
</DocsLayout>
