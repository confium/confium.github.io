---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageHero from '../../components/astro/PageHero.astro';
import { byOrder, toCardItems, buildSidebar } from '../../lib/nav';

const docs = byOrder(await import('astro:content').then((m) => m.getCollection('docs')));
const sidebar = await buildSidebar('docs');
const cards = toCardItems(docs);
---

<DocsLayout title="Docs" description="Technical documentation for Confium — architecture, four deployment modes, components, security, deployment, benchmarks, quickstarts, migration guides, API references." sidebar={sidebar}>
  <PageHero
    eyebrow="Documentation"
    title="Docs"
    description="Technical documentation for the Confium engine, its four deployment modes, deployment artifacts, benchmarks, and the principles that shape every crate."
  />

  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {cards.map((card) => (
      <li>
        <a href={card.href} class="group block h-full rounded-lg border border-line bg-card p-5 hover:border-brand-300 dark:hover:border-brand-700 transition-colors">
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="text-lg font-semibold group-hover:text-brand-700 dark:group-hover:text-brand-300">{card.title}</h2>
            <span aria-hidden="true" class="text-muted-foreground group-hover:text-brand-600">→</span>
          </div>
          {card.description && (
            <p class="mt-1 text-sm text-muted-foreground">{card.description}</p>
          )}
        </a>
      </li>
    ))}
  </ul>
</DocsLayout>
