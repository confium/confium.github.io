---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOC_GROUP_LABELS, DOC_GROUP_ORDER } from '../../lib/nav';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { id: doc.id },
    props: { doc, allDocs: docs },
  }));
}

const { doc, allDocs } = Astro.props;
const { Content, headings } = await render(doc);

const GROUPS = new Map();
for (const d of [...allDocs].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))) {
  const key = d.data.group ?? 'start';
  if (!GROUPS.has(key)) GROUPS.set(key, []);
  GROUPS.get(key).push({
    label: d.data.title,
    href: `/docs/${d.id}/`,
    current: d.id === doc.id,
  });
}
const sidebar = DOC_GROUP_ORDER
  .filter((key) => GROUPS.has(key))
  .map((key) => ({ heading: DOC_GROUP_LABELS[key], items: GROUPS.get(key) }));
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  sidebar={sidebar}
  headings={headings}
  sourcePath={`src/content/docs/${doc.id}.mdx`}
>
  <Content />
</DocsLayout>
