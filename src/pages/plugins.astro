---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import Reveal from '../components/vue/Reveal.vue';
import CopyButton from '../components/vue/CopyButton.vue';

const plugins = [
  {
    name: 'botan',
    version: '3.2.0',
    description: 'Botan crypto provider plugin — FIPS-capable backend providing SHA-256, AES-GCM, Ed25519, ECDSA, and more.',
    interfaces: ['hash', 'cipher', 'aead', 'signature', 'kem'],
    algorithms: ['SHA-256', 'SHA-384', 'SHA-512', 'AES-256-GCM', 'ChaCha20-Poly1305', 'Ed25519', 'ECDSA-P256', 'ECDSA-P384'],
    publisher: 'Ribose Open',
    publisherKey: 'ribose',
    fipsCapable: true,
    installCommand: 'confium install botan',
  },
];

const upcomingPlugins = [
  { name: 'openssl', description: 'OpenSSL crypto provider plugin — wraps libcrypto for hash, cipher, AEAD, and signature operations.' },
  { name: 'ring', description: 'Ring crypto provider — high-performance Rust crypto for hash, AEAD, and signature operations.' },
  { name: 'frost-ed25519', description: 'FROST threshold signature protocol implementation for Ed25519.' },
  { name: 'frost-p256', description: 'FROST threshold signature protocol implementation for P-256 / ECDSA.' },
  { name: 'cmp20', description: 'CMP20 threshold ECDSA protocol implementation.' },
  { name: 'ml-dsa-65', description: 'ML-DSA-65 (FIPS 204) post-quantum signature algorithm.' },
  { name: 'sm2-sm3', description: 'Chinese national standard SM2/SM3 cryptographic algorithms.' },
];
---

<BaseLayout
  title="Plugin marketplace"
  description="Browse and install Confium crypto plugins. The registry is open — anyone can publish a signed plugin."
>
  <PageHero
    eyebrow="Plugins"
    title="Plugin marketplace"
    description="Confium plugins provide cryptographic algorithms via the cfmp_* contract. Install with one command; verify signatures automatically. The registry is open — anyone can publish."
  />

  <div class="mx-auto w-full max-w-6xl px-6 py-12 md:py-16">
    <!-- Available plugins -->
    <Reveal>
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <p class="mono-label">Available now</p>
          <h2 class="mt-2 font-sans text-2xl font-bold">Published plugins</h2>
        </div>
        <a href="https://github.com/confium/confium/tree/main/sites/registry" class="text-sm font-semibold text-accent hover:text-accent-deep">
          Browse source →
        </a>
      </div>
    </Reveal>

    <div class="space-y-4">
      {plugins.map((p, i) => (
        <Reveal delayMs={i * 60}>
          <div class="card p-6">
            <div class="grid md:grid-cols-[1fr_auto] gap-6 items-start">
              <div>
                <div class="flex items-center gap-3 mb-2">
                  <h3 class="font-sans text-xl font-bold">{p.name}</h3>
                  <span class="font-mono text-xs px-2 py-0.5 rounded-md bg-accent/10 text-accent">v{p.version}</span>
                  {p.fipsCapable && (
                    <span class="font-mono text-xs px-2 py-0.5 rounded-md bg-gold-ink/10 text-gold-ink">FIPS-capable</span>
                  )}
                </div>
                <p class="text-sm text-muted leading-relaxed">{p.description}</p>

                <div class="mt-4">
                  <p class="font-mono text-[0.7rem] uppercase tracking-wider text-faint mb-2">Interfaces</p>
                  <div class="flex flex-wrap gap-1.5">
                    {p.interfaces.map((iface) => (
                      <span class="font-mono text-xs px-2 py-1 rounded border border-line bg-surface text-muted">{iface}</span>
                    ))}
                  </div>
                </div>

                <div class="mt-3">
                  <p class="font-mono text-[0.7rem] uppercase tracking-wider text-faint mb-2">Algorithms</p>
                  <div class="flex flex-wrap gap-1.5">
                    {p.algorithms.map((alg) => (
                      <span class="font-mono text-xs px-2 py-1 rounded border border-line bg-surface-dim text-muted">{alg}</span>
                    ))}
                  </div>
                </div>

                <p class="mt-4 text-xs text-faint">
                  Signed by <span class="font-mono text-accent">{p.publisher}</span> ({p.publisherKey})
                </p>
              </div>

              <div class="md:text-right">
                <p class="font-mono text-[0.7rem] uppercase tracking-wider text-faint mb-2">Install</p>
                <div class="flex items-center gap-2 md:justify-end">
                  <code class="font-mono text-sm bg-surface-dim border border-line rounded-md px-3 py-1.5">
                    &#123;p.installCommand&#125;
                  </code>
                  <CopyButton value={p.installCommand} label="" size="sm" client:load />
                </div>
              </div>
            </div>
          </div>
        </Reveal>
      ))}
    </div>

    <!-- Upcoming plugins -->
    <Reveal>
      <div class="mt-12 mb-6">
        <p class="mono-label">In development</p>
        <h2 class="mt-2 font-sans text-2xl font-bold">Upcoming plugins</h2>
        <p class="mt-1 text-sm text-muted">
          These plugins are in development. Watch the repos or contribute via PR.
        </p>
      </div>
    </Reveal>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {upcomingPlugins.map((p, i) => (
        <Reveal delayMs={i * 40}>
          <div class="card p-5 h-full">
            <h3 class="font-sans text-base font-bold font-mono">{p.name}</h3>
            <p class="mt-1.5 text-xs leading-relaxed text-muted">{p.description}</p>
          </div>
        </Reveal>
      ))}
    </div>

    <!-- Publishing guide -->
    <Reveal>
      <div class="mt-12 p-6 md:p-8 rounded-xl border border-line bg-surface-dim">
        <p class="mono-label">For plugin authors</p>
        <h2 class="mt-2 font-sans text-xl font-bold">Publish your own plugin</h2>
        <p class="mt-2 text-sm text-muted max-w-2xl">
          The Confium registry is open. Write a plugin in any language that
          produces a cdylib, wrap it with <code class="font-mono text-xs bg-surface px-1.5 py-0.5 rounded">confium-publish</code>,
          sign the manifest with your PGP key, and submit a PR against the registry.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/docs/cli/publish/" class="btn btn-primary">
            confium-publish guide
            <span aria-hidden="true">→</span>
          </a>
          <a href="https://github.com/confium/confium/tree/main/docs/.mdx" class="btn btn-outline">
            Plugin author guide
          </a>
          <a href="/audiences/contributors/" class="btn btn-outline">
            Contribute
          </a>
        </div>
      </div>
    </Reveal>

    <!-- Registry trust model -->
    <Reveal>
      <div class="mt-8 grid md:grid-cols-3 gap-4">
        <div class="card p-5">
          <p class="mono-label !text-accent">Trust</p>
          <h3 class="mt-2 font-sans text-base font-bold">Signed manifests</h3>
          <p class="mt-1 text-xs text-muted">
            Every plugin manifest is PGP-signed by the publisher. The CLI
            verifies the signature against the trusted-publisher list before
            install.
          </p>
        </div>
        <div class="card p-5">
          <p class="mono-label !text-accent2">Verify</p>
          <h3 class="mt-2 font-sans text-base font-bold">SHA-256 attestation</h3>
          <p class="mt-1 text-xs text-muted">
            The manifest records the SHA-256 of the binary artifact. The CLI
            re-computes and compares after download.
          </p>
        </div>
        <div class="card p-5">
          <p class="mono-label !text-gold-ink">Audit</p>
          <h3 class="mt-2 font-sans text-base font-bold">Transparent registry</h3>
          <p class="mt-1 text-xs text-muted">
            The registry is a git repository. Every addition, update, and
            takedown is a PR visible to the public.
          </p>
        </div>
      </div>
    </Reveal>
  </div>
</BaseLayout>
