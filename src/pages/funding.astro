---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import Reveal from '../components/vue/Reveal.vue';

const grants = [
  {
    name: 'NLnet NGI Zero PET',
    href: 'https://nlnet.nl/project/Confium/',
    role: 'Core framework engineering — engine, plugin contract, threshold protocols, transparency log.',
    description: 'NGI Zero PET (Privacy and Trust Enhancing Technologies) is a European Commission-funded grant program administered by NLnet. It funds open-source work that strengthens the privacy and trust properties of the internet.',
  },
  {
    name: 'Mozilla MOSS',
    href: 'https://www.mozilla.org/moss/',
    role: 'Open-source sustainability — audit, documentation, and integration testing.',
    description: 'The Mozilla Open Source Support program funds open-source projects that contribute to a healthy, secure, and accessible web. Confium received a MOSS award for cross-cutting security and documentation work.',
  },
];
---

<BaseLayout title="Funding" description="Confium is funded by NLnet NGI Zero PET and Mozilla MOSS. This page describes what each grant covers and the funder relationship.">
  <PageHero
    eyebrow="Funding"
    title="Open-source, sustainably funded"
    description="Confium is free, BSD-2-Clause software. The engineering effort is underwritten by two open-source-focused funders."
  />

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-8">
      {grants.map((g, i) => (
        <Reveal delayMs={i * 80}>
          <article class="rounded-lg border border-line bg-card p-6 shadow-card">
            <div class="flex flex-wrap items-baseline justify-between gap-3 mb-3">
              <h2 class="text-xl font-semibold">
                <a href={g.href} class="hover:text-brand-700 dark:hover:text-brand-300">{g.name}</a>
              </h2>
              <span class="text-xs font-mono uppercase tracking-wider text-muted-foreground">Funder</span>
            </div>
            <p class="text-sm font-medium text-brand-700 dark:text-brand-300 mb-3">{g.role}</p>
            <p class="text-sm text-muted-foreground">{g.description}</p>
          </article>
        </Reveal>
      ))}
    </div>

    <div class="mt-12 p-6 rounded-lg bg-brand-50/40 dark:bg-brand-900/15 border border-brand-200 dark:border-brand-800">
      <h2 class="text-lg font-semibold mb-2">Funder independence</h2>
      <p class="text-sm text-muted-foreground">
        Funders do not direct the technical direction. Their support
        underwrites the engineering effort; project decisions remain
        with the maintainer collective. Funding does not purchase
        early access, prioritized features, or veto rights.
      </p>
    </div>

    <div class="mt-8 text-center">
      <a href="/about/" class="text-sm text-muted-foreground hover:text-foreground">
        About Confium →
      </a>
    </div>
  </div>
</BaseLayout>
