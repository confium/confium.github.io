---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/astro/PageHero.astro';
import Reveal from '../components/vue/Reveal.vue';

const grants = [
  {
    name: 'NLnet',
    role: 'Project sponsor via NGI Zero PET',
    href: 'https://nlnet.nl/',
    logo: '/assets/nlnet-banner.svg',
    logoAlt: 'NLnet logo',
    description: 'NLnet is a Dutch foundation that funds open-source network and trust projects. Through the NGI Zero PET program, NLnet administers European Commission support for Confium\'s core framework engineering: engine, plugin contract, threshold protocols, and transparency log.',
  },
  {
    name: 'NGI Zero PET',
    role: 'European Commission · Next Generation Internet',
    href: 'https://www.ngi.eu/ngi-projects/ngi-zero-pet/',
    logo: '/assets/ngi-zeropet-banner.svg',
    logoAlt: 'NGI Zero PET logo',
    description: 'NGI Zero PET (Privacy and Trust Enhancing Technologies) is a European Commission initiative under the Next Generation Internet program. It funds open-source work that strengthens the privacy and trust properties of the internet. Confium is one of the funded projects.',
  },
  {
    name: 'Mozilla MOSS',
    role: 'Open Source Support',
    href: 'https://www.mozilla.org/moss/',
    logo: null,
    wordmark: 'mozilla',
    description: 'The Mozilla Open Source Support program funds open-source projects that contribute to a healthy, secure, and accessible web. Confium received a MOSS award for cross-cutting security and documentation work.',
  },
];
---

<BaseLayout title="Funding" description="Confium is funded by NLnet NGI Zero PET (European Commission) and Mozilla MOSS. This page describes what each grant covers and the funder relationship.">
  <PageHero
    eyebrow="Funding"
    title="Sponsored by NLnet, NGI Zero PET, and Mozilla MOSS"
    description="Confium is free, BSD-2-Clause software. The engineering effort has been sponsored by the European Commission through NGI Zero PET, plus Mozilla MOSS."
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="space-y-6">
      {grants.map((g, i) => (
        <Reveal delayMs={i * 80}>
          <article class="rounded-lg border border-line bg-card p-6 sm:p-8 shadow-card">
            <div class="grid md:grid-cols-[14rem_minmax(0,1fr)] gap-6 items-start">
              <div class="rounded-md bg-brand-50/30 dark:bg-brand-900/10 p-6 flex items-center justify-center min-h-24">
                {g.logo ? (
                  <img
                    src={g.logo}
                    alt={g.logoAlt}
                    class="max-h-20 w-auto"
                    loading="lazy"
                  />
                ) : (
                  <span class="font-bold text-3xl tracking-tight">{g.wordmark}</span>
                )}
              </div>
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-3 mb-2">
                  <h2 class="text-2xl font-semibold">
                    <a href={g.href} class="hover:text-brand-700 dark:hover:text-brand-300">{g.name}</a>
                  </h2>
                  <span class="text-xs font-mono uppercase tracking-wider text-brand-700 dark:text-brand-300">
                    {g.role}
                  </span>
                </div>
                <p class="text-sm text-muted-foreground">{g.description}</p>
                <p class="mt-4">
                  <a
                    href={g.href}
                    class="text-sm text-brand-700 dark:text-brand-300 hover:underline font-medium"
                  >
                    Visit {g.name} →
                  </a>
                </p>
              </div>
            </div>
          </article>
        </Reveal>
      ))}
    </div>

    <Reveal>
      <div class="mt-12 p-6 rounded-lg bg-brand-50/40 dark:bg-brand-900/15 border border-brand-200 dark:border-brand-800">
        <h2 class="text-lg font-semibold mb-2">Sponsor independence</h2>
        <p class="text-sm text-muted-foreground">
          Sponsors do not direct the technical direction. Their sponsorship
          supports the engineering effort; project decisions remain
          with the maintainer collective. Sponsorship does not purchase
          early access, prioritized features, or veto rights.
        </p>
      </div>
    </Reveal>

    <div class="mt-8 text-center">
      <a href="/about/" class="text-sm text-muted-foreground hover:text-foreground">
        About Confium →
      </a>
    </div>
  </div>
</BaseLayout>
